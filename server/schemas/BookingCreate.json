{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "BookingCreate.json",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "typeId": {
            "type": "string"
        },
        "slotStart": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "name",
        "email",
        "typeId",
        "slotStart"
    ]
}